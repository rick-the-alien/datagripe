# DataGripe server configuration.
#
# Zero-config default: with no APP_DATABASE_URL the server starts an
# embedded PostgreSQL cluster (data in ./data/pg), migrates it
# automatically, generates local secrets (./data/datagripe.secrets.json),
# and runs with AUTH_DISABLED=true — direct in, no accounts.
#
# Everything below is OPTIONAL and only needed for a shared/external
# PostgreSQL deployment like a team server or this repository's compose
# setup.

NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# --- external mode -------------------------------------------------------
# Setting APP_DATABASE_URL selects external mode: the given PostgreSQL is
# used as-is, both secrets are REQUIRED, auth defaults to enabled, and
# migrations run via `bun run db:migrate` (not automatically).
APP_DATABASE_URL=postgres://datagripe:datagripe@localhost:5432/datagripe
CONNECTION_ENCRYPTION_KEY=replace-with-a-generated-development-key
SESSION_SECRET=replace-with-a-generated-development-secret

# Force a mode regardless of APP_DATABASE_URL presence:
# DATABASE_MODE=embedded
# DATABASE_MODE=external

# Embedded cluster location/port (0 = auto):
# EMBEDDED_PG_DATA_DIR=./data/pg
# EMBEDDED_PG_PORT=0

# Force account auth on/off regardless of mode default:
# AUTH_DISABLED=true
# AUTH_DISABLED=false

# Serve the built web app from the server (single-binary / desktop):
# WEB_STATIC_DIR=./apps/web/dist

QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=10000
QUERY_MAX_BYTES=25000000
MAX_CONCURRENT_QUERIES_PER_USER=3
# Optional: predefined connections file (default ./connections.json, gitignored)
# CONNECTIONS_FILE=./connections.json
# Allow account signup after the first (bootstrap) account exists
ALLOW_SIGNUP=false
# Comma-separated target hosts allowed despite SSRF private-range blocks
# TARGET_HOST_ALLOWLIST=localhost,127.0.0.1,::1
# Disable SSRF target-host blocking entirely. Only for trusted-network
# deployments: the server will connect to any host, including private
# ranges, loopback, and cloud metadata endpoints.
# SSRF_DISABLED=false
