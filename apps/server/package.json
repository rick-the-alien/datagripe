		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@datagripe/contracts": "*",
		"@datagripe/database-adapters": "*",
		"@datagripe/sql-tools": "*",
		"embedded-postgres": "^18.4.0-beta.17",
		"zod": "^4.1.5"
