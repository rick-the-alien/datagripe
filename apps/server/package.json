{
	"name": "@datagripe/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./config": "./src/config.ts",
		"./db/app/pool": "./src/db/app/pool.ts",
		"./db/app/migrate": "./src/db/app/migrate.ts",
		"./ws/handler": "./src/ws/handler.ts",
		"./http/errors": "./src/http/errors.ts",
		"./log": "./src/log.ts"
	},
	"scripts": {
